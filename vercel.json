{
  "rewrites": [
    { "source": "/apparels", "destination": "/apparels/index.html" },
    { "source": "/build", "destination": "/build/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
